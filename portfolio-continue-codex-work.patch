diff --git a/src/components/ui/Reveal.tsx b/src/components/ui/Reveal.tsx
new file mode 100644
index 0000000..f2a4d2a
--- /dev/null
+++ b/src/components/ui/Reveal.tsx
@@ -0,0 +1,70 @@
+import { m, useInView, useReducedMotion } from 'framer-motion'
+import type { CSSProperties, ReactNode } from 'react'
+import { useRef } from 'react'
+
+interface RevealProps {
+  children: ReactNode
+  index?: number
+  delayStep?: number
+  maxDelay?: number
+  y?: number
+  scale?: number
+  blur?: number
+  once?: boolean
+  amount?: number
+  className?: string
+  style?: CSSProperties
+}
+
+/**
+ * Reveals its children with a staggered depth/opacity transition once they
+ * scroll into view. Built on framer-motion's `useInView` hook (plain
+ * IntersectionObserver under the hood) rather than the `whileInView` prop,
+ * so it works with the app's existing `LazyMotion features={domAnimation}`
+ * bundle, which doesn't include the separate "inView" feature.
+ */
+const Reveal = ({
+  children,
+  index = 0,
+  delayStep = 0.06,
+  maxDelay = 0.36,
+  y = 32,
+  scale = 0.94,
+  blur = 0,
+  once = true,
+  amount = 0.2,
+  className,
+  style,
+}: RevealProps) => {
+  const ref = useRef<HTMLDivElement>(null)
+  const reduceMotion = useReducedMotion()
+  const isInView = useInView(ref, { once, amount })
+  const delay = Math.min(index * delayStep, maxDelay)
+
+  if (reduceMotion) {
+    return (
+      <div ref={ref} className={className} style={style}>
+        {children}
+      </div>
+    )
+  }
+
+  return (
+    <m.div
+      ref={ref}
+      className={className}
+      style={style}
+      initial={{ opacity: 0, y, scale, filter: blur ? `blur(${blur}px)` : 'blur(0px)' }}
+      animate={
+        isInView
+          ? { opacity: 1, y: 0, scale: 1, filter: 'blur(0px)' }
+          : undefined
+      }
+      transition={{ duration: 0.65, delay, ease: [0.22, 1, 0.36, 1] }}
+    >
+      {children}
+    </m.div>
+  )
+}
+
+export default Reveal
